# Server-only. Never put this in a NUXT_PUBLIC_ variable.
NUXT_ANTHROPIC_API_KEY=

# Set to true for the public demo: the tutor routes return canned answers and make no API calls.
DEMO_MODE=false

# Supabase: the project URL and the PUBLISHABLE key only. Never put the secret (service role) key here.
SUPABASE_URL=
SUPABASE_KEY=
